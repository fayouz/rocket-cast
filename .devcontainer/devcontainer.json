{
  "name": "Rocket Cast (démo)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "forwardPorts": [3600, 3601],
  "portsAttributes": {
    "3600": { "label": "Rocket Cast", "onAutoForward": "notify" },
    "3601": { "label": "Documentation et changelog", "onAutoForward": "notify" },
    "8600": { "label": "API", "onAutoForward": "silent" },
    "5432": { "onAutoForward": "ignore" }
  },
  "postStartCommand": "bash demo/codespaces/start.sh"
}
